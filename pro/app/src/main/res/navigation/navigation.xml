<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation"
    app:startDestination="@id/titleFragment"
    android:label="@string/app_name">
    <fragment
        android:id="@+id/titleFragment"
        android:name="com.example.pro.TitleFragment"
        tools:layout="@layout/fragment_start" >
        <action
            android:id="@+id/action_titleFragment_to_gamesFragment"
            app:destination="@id/gamesFragment" />
    </fragment>
    <fragment
        android:id="@+id/gamesFragment"
        android:name="com.example.pro.game.GamesFragment"
        tools:layout="@layout/fragment_games"
        >
        <action
            android:id="@+id/action_gamesFragment_to_scoreFragment"
            app:destination="@id/scoreFragment"
            app:popUpTo="@id/gamesFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/aboutFragment"
        android:name="com.example.pro.AboutFragment"
        app:layout="@layout/fragment_about" />
    <fragment
        android:id="@+id/scoreFragment"
        android:name="com.example.pro.score.ScoreFragment"
        tools:layout="@layout/fragment_score">
        <argument
            android:name="score"
            app:argType="integer"
            android:defaultValue="0" />
        <action
            android:id="@+id/action_scoreFragment_to_gamesFragment"
            app:destination="@id/gamesFragment" />
        <action
            android:id="@+id/action_scoreFragment_to_titleFragment"
            app:destination="@id/titleFragment" />
    </fragment>
    <fragment
        android:id="@+id/historyFragment"
        android:name="com.example.pro.history.HistoryFragment"
         />
</navigation>